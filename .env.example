# Clave de la API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo a usar
CLAUDE_MODEL=claude-sonnet-5-5
# Opcional: código que deben escribir los usuarios para subir planos (evita gastos ajenos)
ACCESS_CODE=
# Opcional: máximo de planos por IP por hora
RATE_PER_HOUR=20
PORT=3000
